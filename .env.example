# ============================================================
# EASY-POINT UI — Environment Variables
# Copy to .env and fill in for local development.
# In production these are injected by the platform (Cloud Run
# --set-env-vars, ECS task definition, etc.) — never baked into
# the Docker image or committed here with real values.
# ============================================================

# Backend NestJS API — only accessible from the Next.js server.
# This URL is NEVER exposed to the browser (no NEXT_PUBLIC_ prefix).
# REQUIRED — the app refuses to start without it (see instrumentation.ts).
BACKEND_API_URL=http://localhost:3001

# API version prefix used to build /api/v1/... URLs in shared/api/backend-fetch.ts.
# Note: the /api/auth/* routes hardcode /api/v1 and ignore this value.
API_VERSION=v1

# NestJS endpoint hit by the OTP request step (app/api/auth/request-otp/route.ts).
#   Development (default): /api/v1/development/otp  — OTP is printed to the
#     NestJS console instead of emailed. Safe default for local dev.
#   Production: set this to the real endpoint (e.g. /api/v1/auth/otp) so the
#     OTP is actually emailed. REQUIRED when NODE_ENV=production.
OTP_REQUEST_PATH=/api/v1/development/otp

# Timeout (ms) for requests the BFF proxy makes to the backend
# (shared/api/backend-fetch.ts). Optional — defaults to 30000.
BACKEND_TIMEOUT_MS=30000
